{
    "name": "reportbrains/filament-report-designer",
    "description": "Drag-and-drop report designer for FilamentPHP. Templates are stored as JSON and rendered to Markdown, HTML, PDF or spreadsheets.",
    "keywords": ["laravel", "filament", "report", "report-builder", "markdown", "pdf"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ReportBrains\\ReportDesigner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReportBrains\\ReportDesigner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ReportBrains\\ReportDesigner\\ReportDesignerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
